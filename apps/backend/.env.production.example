# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in the values
# ============================================

# Environment
NODE_ENV=production
PORT=10000

# Frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-frontend.onrender.com

# ============================================
# PostgreSQL Database (Render postgres or external)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# LiveKit Cloud (https://cloud.livekit.io)
# ============================================
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ============================================
# AI/ML Providers
# ============================================

# Fireworks (https://fireworks.ai/account/api-keys)
FIREWORKS_API_KEY=fw_...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ElevenLabs STT + TTS (https://elevenlabs.io)
ELEVENLABS_API_KEY=...

# ============================================
# Voice Pipeline Configuration
# ============================================
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_LANGUAGE=en

STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2_realtime
STT_LANGUAGE=en

LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
LLM_FAST_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=fireworks/qwen3-embedding-8b

# ============================================
# LangSmith (Optional - for tracing)
# ============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=capstone-reviewer

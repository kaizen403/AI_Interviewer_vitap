# =============================================================================
# Capstone Reviewer Backend - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

PORT=3040
NODE_ENV=development
FRONTEND_URL=http://localhost:3050

# -----------------------------------------------------------------------------
# PostgreSQL (root docker-compose.yml, pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone123
POSTGRES_DB=capstone_reviewer
DATABASE_URL=postgresql://capstone:capstone123@localhost:5434/capstone_reviewer

# -----------------------------------------------------------------------------
# LiveKit (root docker-compose.yml --dev defaults)
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# -----------------------------------------------------------------------------
# Fireworks (LLM & embeddings) — https://fireworks.ai/account/api-keys
# -----------------------------------------------------------------------------
FIREWORKS_API_KEY=fw_your-fireworks-api-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# -----------------------------------------------------------------------------
# ElevenLabs (Speech-to-Text + Text-to-Speech) — https://elevenlabs.io
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key

STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2_realtime
STT_LANGUAGE=en

TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_LANGUAGE=en

LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
LLM_FAST_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=fireworks/qwen3-embedding-8b

# -----------------------------------------------------------------------------
# LangSmith (optional)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=capstone-reviewer

# -----------------------------------------------------------------------------
# Cloudflare R2 (PPT storage)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=capstone-ppt
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
